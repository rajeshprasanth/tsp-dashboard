# Copy to /etc/tsp-dashboard.env for the systemd service:
#   sudo cp .env.example /etc/tsp-dashboard.env
#   sudo chmod 600 /etc/tsp-dashboard.env
#   sudo $EDITOR /etc/tsp-dashboard.env
#   sudo systemctl restart tsp-dashboard
#
# For local development just copy it to .env in the project root — the app
# loads it automatically (existing env vars always win):
#   cp .env.example .env
#
# This file is compatible with both a systemd EnvironmentFile (KEY=VALUE
# lines, '#' = comment) and python-dotenv ('.env').

# --- secrets (REQUIRED — change these) ---
TSPD_SECRET_KEY=generate-a-long-random-string-e.g.-openssl-rand-hex-64

# --- gunicorn (see gunicorn.conf.py) ---
TSPD_BIND_HOST=127.0.0.1
TSPD_PORT=8766
TSPD_WORKERS=2
TSPD_THREADS=4
TSPD_LOG_LEVEL=info

# --- session cookie (set 'true' when serving over HTTPS) ---
TSPD_COOKIE_SECURE=false

# --- users file (PBKDF2-hashed, created via manage.py) ---
TSPD_USERS_FILE=/data/users.json

# --- tsp daemon ---
# NOTE: do NOT put TMPDIR in a local .env — the app loads it into its own
# environment and the spawned `tsp` then looks for the daemon socket in the
# wrong place, hiding a daemon that runs under the default TMPDIR.
# TMPDIR is only meaningful in the service EnvironmentFile
# (/etc/tsp-dashboard.env) on a systemd /data deployment:
# TMPDIR=/data